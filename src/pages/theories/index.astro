---
const theories = [
  {
    title: 'Digital Twin Theory',
    href: '/Agent-Theories/theories/systems/digital-twin',
    status: 'tested',
    description:
      'A synchronized digital representation of a real-world system used for monitoring, simulation, prediction, and optimization.'
  }
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>All Theories</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        background: #020617;
        color: #e2e8f0;
        margin: 0;
        padding: 30px;
      }
      h1 {
        text-align: center;
      }
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
        max-width: 1200px;
        margin: auto;
      }
      .card {
        background: #111827;
        padding: 24px;
        border-radius: 14px;
      }
      .status {
        display: inline-block;
        margin-top: 10px;
        padding: 6px 12px;
        border-radius: 999px;
        background: #1e293b;
      }
      a {
        color: #60a5fa;
      }
    </style>
  </head>
  <body>
    <h1>All Theories</h1>

    <div class="grid">
      {theories.map((theory) => (
        <div class="card">
          <h2>
            <a href={theory.href}>{theory.title}</a>
          </h2>
          <p>{theory.description}</p>
          <span class="status">{theory.status}</span>
        </div>
      ))}
    </div>
  </body>
</html>
