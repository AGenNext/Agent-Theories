---
import { getCollection } from 'astro:content';
import CitationList from '../../components/CitationList.astro';

export async function getStaticPaths() {
  const theories = await getCollection('theories');

  return theories.map((theory) => ({
    params: { slug: theory.slug },
    props: { theory }
  }));
}

const { theory } = Astro.props;
const { Content } = await theory.render();
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{theory.data.name} • Agent Theories</title>

    <style>
      body {
        font-family: Arial, sans-serif;
        background: #020617;
        color: #e2e8f0;
        margin: 0;
      }

      main {
        max-width: 900px;
        margin: auto;
        padding: 40px 20px;
      }

      .meta, .section {
        background: #111827;
        padding: 20px;
        border-radius: 14px;
        margin-bottom: 30px;
      }

      .tag {
        display: inline-block;
        margin: 4px;
        padding: 6px 10px;
        border-radius: 999px;
        background: #1e293b;
      }

      .metric {
        display: inline-block;
        margin-right: 12px;
        margin-top: 12px;
        padding: 8px 12px;
        border-radius: 10px;
        background: #0f172a;
      }

      a {
        color: #60a5fa;
      }

      h1, h2, h3 {
        color: #f8fafc;
      }

      p, li {
        line-height: 1.7;
      }

      ul {
        padding-left: 20px;
      }
    </style>
  </head>

  <body>
    <main>
      <a href="/Agent-Theories/theories">← All theories</a>

      <div class="meta">
        <h1>{theory.data.name}</h1>

        <p>{theory.data.summary}</p>

        <div class="metric">
          <strong>Status:</strong> {theory.data.status}
        </div>

        <div class="metric">
          <strong>Review:</strong> {theory.data.review_status}
        </div>

        <div class="metric">
          <strong>Confidence:</strong> {(theory.data.confidence_score * 100).toFixed(0)}%
        </div>

        <div class="metric">
          <strong>Validation:</strong> {theory.data.validation_status}
        </div>

        <div>
          {theory.data.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      </div>

      <div class="section">
        <h2>Testing and Validation</h2>

        {theory.data.testability && (
          <p><strong>Testability:</strong> {theory.data.testability}</p>
        )}

        {theory.data.testing_methods?.length > 0 && (
          <>
            <h3>Testing Methods</h3>
            <ul>
              {theory.data.testing_methods.map((method) => (
                <li>{method}</li>
              ))}
            </ul>
          </>
        )}

        {theory.data.falsifiable_predictions?.length > 0 && (
          <>
            <h3>Falsifiable Predictions</h3>
            <ul>
              {theory.data.falsifiable_predictions.map((prediction) => (
                <li>{prediction}</li>
              ))}
            </ul>
          </>
        )}
      </div>

      <div class="section">
        <h2>Applications and Safety</h2>

        {theory.data.application_domains?.length > 0 && (
          <>
            <h3>Application Domains</h3>
            <ul>
              {theory.data.application_domains.map((domain) => (
                <li>{domain}</li>
              ))}
            </ul>
          </>
        )}

        {theory.data.observed_outcomes?.length > 0 && (
          <>
            <h3>Observed Outcomes</h3>
            <ul>
              {theory.data.observed_outcomes.map((outcome) => (
                <li>{outcome}</li>
              ))}
            </ul>
          </>
        )}

        {theory.data.safety_considerations?.length > 0 && (
          <>
            <h3>Safety Considerations</h3>
            <ul>
              {theory.data.safety_considerations.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </>
        )}
      </div>

      <article>
        <Content />
      </article>

      <CitationList references={theory.data.references} />
    </main>
  </body>
</html>
